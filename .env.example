# Copy to .env and fill in values. All scripts and next dev/start read .env.

# --- Required ---
# MongoDB connection string
MONGODB_URI="mongodb+srv://<user>:<pass>@<cluster>/<db>?retryWrites=true&w=majority"

# Auth.js session signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-openssl-rand-base64-32-output"

# --- Optional: public config ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="/api"
GOOGLE_SITE_VERIFICATION=""

# --- Optional: email notifications (falls back to EMAIL_SERVER_* names) ---
SMTP_HOST=""
SMTP_USER=""
SMTP_PASS=""
SMTP_PORT=587
SMTP_FROM=""
# Set to 1 ONLY for a self-signed internal relay (disables TLS cert checks)
# SMTP_ALLOW_INSECURE_TLS=1

# --- Optional: Cloudinary media uploads ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Optional: remote logging endpoint used by src/lib/logger.ts in production ---
LOGGING_ENDPOINT=""

# --- Scripts only (npm run seed:admin / create:user) ---
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME=""

# --- Build-time escape hatch for Docker/CI without secrets ---
# SKIP_ENV_VALIDATION=1
